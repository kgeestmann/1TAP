# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored, so your token never gets committed.

# Your bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=your-token-here

# Channel ID where moderation actions get logged (right-click channel -> Copy Channel ID)
LOG_CHANNEL_ID=1157410260756201502
